# Swift Boda Environment Configuration
PORT=4000
NODE_ENV=development

# Database & Cache
DATABASE_URL=postgresql://swift_admin:secure_swift_password@localhost:5432/swiftboda_db
REDIS_URL=redis://localhost:6379

# Security & Tokens
